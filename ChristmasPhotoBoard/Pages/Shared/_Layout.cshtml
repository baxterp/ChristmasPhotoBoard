<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChristmasPhotoBoard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/darkly.bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/jquery.fallingsnow.css" />
    <link rel="stylesheet" href="~/css/jquery.lightbox.css" />
    <link rel="stylesheet" href="~/ChristmasPhotoBoard.styles.css" asp-append-version="true" />

</head>
<body>
    <div id="snow">
        <div class="container">
            <header class="xmas-header" style="padding:10px; border-radius: 5px;">
                <span class="navbar-brand mb-0 h1 text-wrap xmas-title">
                    🎅 Family Christmas Photo Board
                </span>
                <div style="padding:8px">
                    <label for="fileInput" class="btn btn-dark">Select Image</label>
                    <input type="file" id="fileInput" accept="image/*" class="form-control btn fileInput" style="display:none"
                        onchange="javascript:ImageUpload()" />
                </div>
            </header>
        </div>
        <div class="container">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery.fallingsnow.js" asp-append-version="true"></script>
    <script src="~/js/jquery.lightbox.js" asp-append-version="true"></script>
    <script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jquery.lazy/1.7.9/jquery.lazy.min.js"></script>
    <script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jquery.lazy/1.7.9/jquery.lazy.plugins.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>