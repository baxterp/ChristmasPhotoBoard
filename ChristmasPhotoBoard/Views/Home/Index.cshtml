@model List<string>
@{
    ViewData["Title"] = "Christmas Photo Board";
    Layout = "/Pages/Shared/_Layout.cshtml";
    var images = Model;
}

<div class="row g-4" style="padding-top: 20px; padding-bottom: 20px">
    @foreach(var imageUrl in images)
    {
        var fileUrl = $"{imageUrl}";
        @* <div class="col-sm-6 col-md-8 col-lg-4"> *@
         <div class="col-12 col-sm-6 col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <a class="lightboxImg" href="@fileUrl"><img src="@fileUrl" class="img-fluid rounded lazy" alt="Xmas"></a>
            </div>
        </div>
    }
</div>
<script type="text/javascript">
    $(function () {
        $('#btnChangeView').html('Show Carousel');
        $("#snow").fallingSnow();
    });
</script>
